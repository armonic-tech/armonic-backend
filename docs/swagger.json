                    "type": "integer"
                },
                "thumbUrl": {
                    "type": "string"
                },
                "url": {
                    "type": "string"
                },
                "userId": {
                    "type": "string"
                },
                "width": {
                    "type": "integer"
                }
            }
        },
        "channel.ChannelInfo": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "serverId": {
                    "type": "string"
                },
                "type": {
                    "type": "string"
                }
            }
        },
        "channel.Member": {
