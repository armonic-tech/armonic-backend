{
    "swagger": "2.0",
    "info": {
        "description": "Armonic API backend server.",
        "title": "Armonic API",
        "contact": {},
        "version": "1.0"
    },
    "paths": {
        "/auth/login": {
            "post": {
                "description": "Login user in already claimed server",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Users"
                ],
                "summary": "Login user",
                "parameters": [
                    {
                        "description": "User credentials",
                        "name": "credentials",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handlers.LoginRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.LoginResponse"
                        }
                    },
                    "400": {
                        "description": "invalid body",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "invalid credentials",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "403": {
                        "description": "server not claimed yet",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/channel/{id}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Get a single channel by its id, enriched with live voice state (who is connected right now) when it's a voice channel",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Channel"
                ],
                "summary": "Channel info by id",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Channel ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.ChannelDetailResponse"
                        }
                    },
                    "400": {
                        "description": "invalid channel id",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "channel not found",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/channel/{id}/messages": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Get a page of messages for a channel (newest first)",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Channel"
                ],
                "summary": "Channel messages",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Channel ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Max messages to return (default 50, max 100)",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/message.Message"
                            }
                        }
                    },
                    "400": {
                        "description": "invalid channel id",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "channel not found",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/info": {
            "get": {
                "description": "Get status info from server",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Server"
                ],
                "summary": "Server info",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.ServerResponse"
                        }
                    }
                }
            }
        },
        "/invite/signup": {
            "post": {
                "description": "Redeem a single-use invite into a brand-new account; no prior JWT needed.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Invite"
                ],
                "summary": "Invite signup",
                "parameters": [
                    {
                        "description": "Invite token + credentials",
                        "name": "signup",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handlers.InviteSignupRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.InviteSignupResponse"
                        }
                    },
                    "400": {
                        "description": "invalid body",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "403": {
                        "description": "server not claimed yet",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "409": {
                        "description": "username taken",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "410": {
                        "description": "invalid or expired invite",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/invite/status": {
            "get": {
                "description": "Validate an invite link before showing the signup form.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Invite"
                ],
                "summary": "Invite status",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Invite token",
                        "name": "token",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.InviteStatusResponse"
                        }
                    },
                    "410": {
                        "description": "invalid or expired invite",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/server": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "List the servers the authenticated user is a member of",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Server"
                ],
                "summary": "My servers",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/server.ServerInfo"
                            }
                        }
                    },
                    "401": {
                        "description": "unauthorized",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/server/{id}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Get channels from server with server-id",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Server"
                ],
                "summary": "Server id info",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Server ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/channel.ChannelInfo"
                            }
                        }
                    }
                }
            }
        },
        "/server/{id}/invite": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Owner-only. Mint a single-use invite link for a server.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Invite"
                ],
                "summary": "Create invite",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Server ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/handlers.InviteCreatedResponse"
                        }
                    },
                    "401": {
                        "description": "unauthorized",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "403": {
                        "description": "forbidden",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "channel.ChannelInfo": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "serverId": {
                    "type": "string"
                },
                "type": {
                    "type": "string"
                }
            }
        },
        "channel.Member": {
            "type": "object",
            "properties": {
                "deafened": {
                    "type": "boolean"
                },
                "displayName": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "muted": {
                    "type": "boolean"
                }
            }
        },
        "handlers.ChannelDetailResponse": {
            "type": "object",
            "properties": {
                "connected": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/channel.Member"
                    }
                },
                "connectedCount": {
                    "type": "integer"
                },
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "serverId": {
                    "type": "string"
                },
                "type": {
                    "type": "string"
                }
            }
        },
        "handlers.InviteCreatedResponse": {
            "type": "object",
            "properties": {
                "inviteToken": {
                    "type": "string",
                    "example": "6f1c5e0e-..."
                },
                "url": {
                    "type": "string",
                    "example": "https://armonic.example?invite=6f1c5e0e-..."
                }
            }
        },
        "handlers.InviteSignupRequest": {
            "type": "object",
            "properties": {
                "password": {
                    "type": "string",
                    "example": "s3cr3t-p4ss"
                },
                "token": {
                    "type": "string",
                    "example": "6f1c5e0e-..."
                },
                "username": {
                    "type": "string",
                    "example": "member"
                }
            }
        },
        "handlers.InviteSignupResponse": {
            "type": "object",
            "properties": {
                "token": {
                    "type": "string",
                    "example": "eyJhbG..."
                }
            }
        },
        "handlers.InviteStatusResponse": {
            "type": "object",
            "properties": {
                "expiresAt": {
                    "type": "string",
                    "example": "2026-08-13T10:00:00Z"
                },
                "serverId": {
                    "type": "string",
                    "example": "6f1c5e0e-..."
                }
            }
        },
        "handlers.LoginRequest": {
            "type": "object",
            "properties": {
                "password": {
                    "type": "string",
                    "example": "s3cr3t-p4ss"
                },
                "username": {
                    "type": "string",
                    "example": "admin"
                }
            }
        },
        "handlers.LoginResponse": {
            "type": "object",
            "properties": {
                "token": {
                    "type": "string",
                    "example": "eyJhbG..."
                }
            }
        },
        "handlers.ServerResponse": {
            "type": "object",
            "properties": {
                "claimed": {
                    "type": "boolean",
                    "example": false
                },
                "description": {
                    "type": "string",
                    "example": ""
                },
                "host": {
                    "type": "string",
                    "example": "localhost:8080"
                },
                "id": {
                    "type": "string",
                    "example": "1a2b3c4d5e-..."
                },
                "memberCount": {
                    "type": "integer",
                    "example": 0
                },
                "name": {
                    "type": "string",
                    "example": "Armonic"
                }
            }
        },
        "message.Message": {
            "type": "object",
            "properties": {
                "channelId": {
                    "type": "string"
                },
                "content": {
                    "type": "string"
                },
                "createdAt": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "serverId": {
                    "type": "string"
                },
                "userId": {
                    "type": "string"
                }
            }
        },
        "server.ServerInfo": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "ownerId": {
                    "description": "OwnerID is omitted while a server is unclaimed/unowned, so a client can\ntell \"not the owner\" from \"ownership unknown\" and hide owner-only UI.",
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "Type \"Bearer\" followed by a space and the JWT returned by /auth/login. Example: \"Bearer eyJhbGci...\"",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    },
    "tags": [
        {
            "description": "User endpoints",
            "name": "Users"
        },
        {
            "description": "Server endpoint",
            "name": "Server"
        },
        {
            "description": "Channel endpoint",
            "name": "Channel"
        }
    ]
}