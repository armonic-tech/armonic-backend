{
    "swagger": "2.0",
    "info": {
        "description": "Armonic API backend server.",
        "title": "Armonic API",
        "contact": {},
        "version": "1.0"
    },
    "paths": {
        "/attachment/{id}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Member-only. Serves the sanitized image bytes.",
                "tags": [
                    "Attachment"
                ],
                "summary": "Fetch an attachment",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Attachment ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "file"
                        }
                    },
                    "404": {
                        "description": "attachment not found",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/auth/login": {
            "post": {
                "description": "Login user in already claimed server",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Users"
                ],
                "summary": "Login user",
                "parameters": [
                    {
                        "description": "User credentials",
                        "name": "credentials",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handlers.LoginRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.LoginResponse"
                        }
                    },
                    "400": {
                        "description": "invalid body",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "invalid credentials",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "403": {
                        "description": "server not claimed yet",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "409": {
                        "description": "proof of work expired or already used",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "429": {
                        "description": "rate limit exceeded",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/channel/{id}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Get a single channel by its id, enriched with live voice state (who is connected right now) when it's a voice channel",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Channel"
                ],
                "summary": "Channel info by id",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Channel ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.ChannelDetailResponse"
                        }
                    },
                    "400": {
                        "description": "invalid channel id",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "channel not found",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/channel/{id}/messages": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Get a page of messages for a channel (newest first)",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Channel"
                ],
                "summary": "Channel messages",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Channel ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Max messages to return (default 50, max 100)",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/message.Message"
                            }
                        }
                    },
                    "400": {
                        "description": "invalid channel id",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "channel not found",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/info": {
            "get": {
                "description": "Get status info from server",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Server"
                ],
                "summary": "Server info",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.ServerResponse"
                        }
                    }
                }
            }
        },
        "/me": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "The authenticated caller's id, display name and avatar.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Users"
                ],
                "summary": "Own profile",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.MeResponse"
                        }
                    },
                    "401": {
                        "description": "unauthorized",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/me/avatar": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Uploads an image through the same pipeline as attachments and points the caller's avatar at it.",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Users"
                ],
                "summary": "Set own avatar",
                "parameters": [
                    {
                        "type": "file",
                        "description": "Image file",
                        "name": "file",
                        "in": "formData",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/attachment.Attachment"
                        }
                    },
                    "413": {
                        "description": "file exceeds the maximum upload size",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "415": {
                        "description": "unsupported image format",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "429": {
                        "description": "rate limit exceeded",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/me/mls/device": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Declares this install's device id and Ed25519 signing key. Idempotent for the same user; a device id owned by another account is rejected.",
                "consumes": [
                    "application/json"
                ],
                "tags": [
                    "MLS"
                ],
                "summary": "Register an MLS device",
                "parameters": [
                    {
                        "description": "Device",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handlers.RegisterDeviceRequest"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    },
                    "400": {
                        "description": "invalid device",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "409": {
                        "description": "device registered to another user",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/me/mls/keypackages": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Adds single-use key packages for one of the caller's devices. Every server the caller belongs to is nudged (`mls-sync`) so a committer can add the device.",
                "consumes": [
                    "application/json"
                ],
                "tags": [
                    "MLS"
                ],
                "summary": "Publish key packages",
                "parameters": [
                    {
                        "description": "Key packages",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handlers.PublishKeyPackagesRequest"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    },
                    "400": {
                        "description": "invalid key packages",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "403": {
                        "description": "device belongs to another user",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/me/storage": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Bytes the caller's uploads occupy against the per-user quota.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Users"
                ],
                "summary": "Own storage usage",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.StorageResponse"
                        }
                    }
                }
            }
        },
        "/pow/challenge": {
            "get": {
                "description": "Issues an Altcha-compatible challenge. Solve it and send the base64 solution in the \"altcha\" field of the login, claim or invite-signup request. Returns 404 when POW_ENABLED is off.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Users"
                ],
                "summary": "Proof-of-work challenge",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/pow.Challenge"
                        }
                    },
                    "404": {
                        "description": "proof of work is disabled",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/server": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "List the servers the authenticated user is a member of",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Server"
                ],
                "summary": "My servers",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/server.ServerInfo"
                            }
                        }
                    },
                    "401": {
                        "description": "unauthorized",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/server/{id}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Get channels from server with server-id",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Server"
                ],
                "summary": "Server id info",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Server ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/channel.ChannelInfo"
                            }
                        }
                    }
                }
            }
        },
        "/server/{id}/invite": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Owner-only. Mint a single-use invite link for a server.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Invite"
                ],
                "summary": "Create invite",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Server ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/handlers.InviteCreatedResponse"
                        }
                    },
                    "401": {
                        "description": "unauthorized",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "403": {
                        "description": "forbidden",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/server/{id}/members": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Member-only. The roster of a server: every member with their display name, avatar and owner flag, plus whether they currently have a live WebSocket connection.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Server"
                ],
                "summary": "Server members",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Server ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/server.MemberInfo"
                            }
                        }
                    },
                    "400": {
                        "description": "invalid server id",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "403": {
                        "description": "forbidden",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/server/{id}/mls": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Member-only. The group's epoch and roster as the delivery service sees it, the devices waiting to be added or evicted, who is expected to commit, and — for the calling device — any pending welcome and how many key packages it has left.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "MLS"
                ],
                "summary": "MLS group state",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Server ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Calling device",
                        "name": "deviceId",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.GroupStateResponse"
                        }
                    },
                    "403": {
                        "description": "forbidden",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/server/{id}/mls/commit": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Member-only. Advances the group one epoch. Rejected with 409 when built against a stale epoch (fetch the missed commits and retry), 400 when it adds a device without an available key package or removes one not in the group. On success the commit is broadcast as `mls-commit` to every connected member.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "MLS"
                ],
                "summary": "Post a commit",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Server ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Commit",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/mls.CommitRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.CommitResponse"
                        }
                    },
                    "400": {
                        "description": "invalid commit",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "409": {
                        "description": "stale epoch",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/server/{id}/mls/commits": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Member-only. The commits a device missed, in epoch order, so an offline device can catch up.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "MLS"
                ],
                "summary": "Commits after an epoch",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Server ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Last epoch the device applied",
                        "name": "after",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/mls.Commit"
                            }
                        }
                    }
                }
            }
        },
        "/server/{id}/mls/welcome/ack": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Marks a welcome as processed so the state endpoint stops returning it.",
                "consumes": [
                    "application/json"
                ],
                "tags": [
                    "MLS"
                ],
                "summary": "Acknowledge a welcome",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Server ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Welcome",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handlers.ConsumeWelcomeRequest"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    }
                }
            }
        },
        "/server/{id}/upload": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Member-only. Multipart upload of one image (field \"file\"). The file is validated by magic number, decoded, stripped of all metadata by re-encoding its pixels, thumbnailed and stored. The uploaded bytes are discarded.",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Attachment"
                ],
                "summary": "Upload an image",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Server ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "file",
                        "description": "Image file",
                        "name": "file",
                        "in": "formData",
                        "required": true
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/attachment.Attachment"
                        }
                    },
                    "400": {
                        "description": "image could not be decoded",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "413": {
                        "description": "file exceeds the maximum upload size",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "415": {
                        "description": "unsupported image format",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "422": {
                        "description": "image dimensions exceed the configured limit",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "429": {
                        "description": "rate limit exceeded",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/server/{id}/upload/encrypted": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Member-only. Multipart upload of an end-to-end encrypted image: \"file\" is the ciphertext of the sanitized image, \"thumb\" the ciphertext of its thumbnail (optional; the full blob doubles as the thumbnail when absent). The server stores both as opaque bytes — it cannot decode, validate or thumbnail them — applying only the byte cap, the per-user rate limit and the storage quota. The keys travel inside the MLS-encrypted message that references the attachment (docs/ai/e2ee.md).",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Attachment"
                ],
                "summary": "Upload an encrypted attachment",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Server ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "file",
                        "description": "Encrypted image",
                        "name": "file",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "file",
                        "description": "Encrypted thumbnail",
                        "name": "thumb",
                        "in": "formData"
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/attachment.Attachment"
                        }
                    },
                    "413": {
                        "description": "file exceeds the maximum upload size",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "429": {
                        "description": "rate limit exceeded",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "507": {
                        "description": "storage quota exceeded",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
