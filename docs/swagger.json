        "handlers.ChannelDetailResponse": {
            "type": "object",
            "properties": {
                "connected": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/channel.Member"
                    }
                },
                "connectedCount": {
                    "type": "integer"
                },
                "id": {
                    "type": "string"
                },
                "name": {
