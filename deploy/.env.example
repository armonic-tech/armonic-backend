# Copy to .env next to docker-compose.prod.yml, fill in, then: chmod 600 .env

# Backend domain, without https:// (an A record pointing at this VPS).
API_DOMAIN=api.example.com
# Web client domain; leave empty if you only use the desktop/Android apps.
APP_DOMAIN=
# https://<APP_DOMAIN> when the web client is used, empty otherwise.
CORS_ALLOWED_ORIGINS=

# openssl rand -hex 32
JWT_SECRET=
# openssl rand -hex 24 — set it before the first `up`; Postgres keeps the first one.
POSTGRES_PASSWORD=
